# Copia este archivo a .env (junto a docker-compose.yml) y rellena valores
# reales. Nunca subas el .env real a Git — .gitignore ya lo excluye.

# Dominio real apuntando a este servidor (registro DNS tipo A).
# Para pruebas locales SIN dominio, usa: DOMAIN=:80
DOMAIN=tu-dominio.com

# Credenciales de MySQL — usa contraseñas largas y distintas entre sí.
DB_ROOT_PASSWORD=cambia_esto_por_una_contrasena_larga
DB_NAME=atlas_almacen
DB_USER=atlas_app
DB_PASSWORD=cambia_esto_tambien_por_otra_distinta

# Genera uno nuevo con: openssl rand -hex 32
JWT_SECRET=cambia_este_valor_por_uno_seguro
JWT_EXPIRES_IN=8h

# En producción (detrás de Caddy) el frontend y el backend quedan en el
# MISMO origen, así que esto debería ser tu dominio real, no localhost.
CORS_ORIGIN=https://tu-dominio.com
