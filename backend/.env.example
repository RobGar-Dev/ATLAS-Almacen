# Copia este archivo a .env y ajusta los valores. Nunca subas el .env real a Git.

PORT=4000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=atlas_almacen

# Genera un valor largo y aleatorio para producción, ej: openssl rand -hex 32
JWT_SECRET=cambia_este_valor_por_uno_seguro
JWT_EXPIRES_IN=8h

# Origen permitido para CORS (tu frontend), ej: http://localhost:5500
CORS_ORIGIN=http://localhost:5500
